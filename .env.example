# Copia este archivo como .env y completa los valores reales.

# Redis
REDIS_URL=redis://127.0.0.1:6379
DISPATCHER_REDIS_URL=
WORKER_REDIS_URL=
DYNAMIC_REDIS_URL=
COLLECTOR_REDIS_URL=

# Orchestrator / API
ORCH_URL=http://127.0.0.1:8000
WORKER_ORCH_URL=
KEYWORD_SERVER_URLS=http://127.0.0.1:8000/keywords
KEYWORDS_API_KEY=change-me

# Hugging Face
HF_TOKEN=
MODEL_NAME=UDA-LIDI/barto_emergency_multi_purpose

# Files
JSONL_PATH=../dataset/conversaciones1.jsonl
OUTPUT_JSON=resultados.json
PROGRESS_FILE=progress.json
REDIS_RESULTS_JSONL=resultados_ordenados.jsonl
MICROSERVICES_JSONL_PATH=../dataset/conversaciones1.jsonl
MICROSERVICES_RESULTS_JSONL=resultados_microservicios.jsonl
TASKS_DB=tasks.db

# Streams
STREAM_IN=stream:convs
DYNAMIC_STREAM_IN=stream:convs
STREAM_OUT=stream:results
CONSUMER_GROUP=group2:convs
DYNAMIC_CONSUMER_GROUP=group2:convs
WORKERS_SET=workers:active

# Runtime tuning
BATCH_SIZE=8
CONCURRENT_REQUESTS=4
BASE_RETRY_DELAY=2
MAX_RETRY_DELAY=60
WORKER_HEARTBEAT_SECONDS=5
CONSUMER_BATCH=4
DYNAMIC_CONSUMER_BATCH=4
CLAIM_MILLIS=30000
RECLAIM_INTERVAL=20
SLEEP_EMPTY=1.0
SLEEP_NO_TASK=1.0
