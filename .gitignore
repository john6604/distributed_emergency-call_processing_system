# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage, and tooling caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Environment variables and local secrets
.env
.env.*
!.env.example
*.key
*.pem

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# Logs
*.log
logs/

# Generated project outputs
server/resultados*.json
server/resultados*.jsonl
Microservicios/resultados*.json
Microservicios/resultados*.jsonl

# Local datasets / sensitive input data
dataset/*.jsonl
!dataset/.gitkeep
!dataset/README.md

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
